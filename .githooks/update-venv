#!/bin/bash
echo "Updating dev venv..."

command -v uv >/dev/null 2>&1 || {
    command -v pipx >/dev/null 2>&1 || {
        python3 -m pip install --user pipx
        python3 -m pipx ensurepath
    }
    pipx install uv
}

PROD_DIR=$(realpath /groups/lantern/.pipeline)
LOCAL_DIR=$(git rev-parse --show-toplevel)

if [[ "${PROD_DIR}" == "${LOCAL_DIR}" ]]; then
    # The deploy venv is shared: its interpreter must live on the share,
    # not in the home directory of whoever ran the sync.
    UV_PYTHON_INSTALL_DIR="${PROD_DIR}/.python" \
        uv sync --frozen --no-dev --managed-python --python 3.11
else
    uv sync --frozen
fi

if [ -z "${VIRTUAL_ENV}" ]; then
    source "${LOCAL_DIR}/.venv/bin/activate"
fi
